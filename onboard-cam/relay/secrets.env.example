# relay/secrets.env 로 복사해서 채운다. secrets.env 는 저장소에 올리지 않는다 (.gitignore).

# 이 서버의 도메인. DNS A 레코드가 이 VM 의 공인 IP 를 가리켜야 한다.
# Cloudflare DNS 를 쓰면 '프록시 (주황 구름)' 를 끄고 DNS 전용 (회색 구름) 으로 둘 것 — WebRTC UDP 는 프록시를 못 지난다.
CAM_DOMAIN=cam.example.org

# Worker 의 공개 키 주소
JWKS_URL=https://sem-ai.jnusem1.workers.dev/api/cam/jwks.json

# 차량 car/secrets.env 의 SRT_PASSPHRASE 와 같은 값 (10 ~ 79 자). 만들기: openssl rand -hex 20  (URL 에 들어가므로 영문 · 숫자만)
SRT_PASSPHRASE=

# Workbench 가 열리는 출처 (CORS)
APP_ORIGIN=https://jnu-sem.github.io
