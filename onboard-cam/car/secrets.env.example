# car/secrets.env 로 복사해서 채운다. secrets.env 는 저장소에 올리지 않는다 (.gitignore).

# 중계 서버 도메인 (relay/secrets.env 의 CAM_DOMAIN)
RELAY_HOST=cam.example.org

# 송출 토큰: node worker/cam-keys.mjs publish-token --key cam-private.jwk.json --days 365
CAM_PUBLISH_TOKEN=

# 중계 서버와 같은 SRT 암호 (영문 · 숫자 10 ~ 79 자, openssl rand -hex 20)
SRT_PASSPHRASE=

# SRT 재전송 여유 (ms). LTE 기본 800 (지연 ↔ 끊김 맞바꿈: 400 ~ 1500)
SRT_LATENCY_MS=800

# 녹화 폴더. USB SSD 를 쓰면 그 마운트 위치로
REC_DIR=/var/lib/sem-cam/rec
